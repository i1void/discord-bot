{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Prefix-based Discord bot with administration tools and AI chat, themed as Frieren",
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "moderation",
    "ai"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop discord-bot",
    "pm2:restart": "pm2 restart discord-bot",
    "pm2:logs": "pm2 logs discord-bot"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i1void/discord-bot.git"
  },
  "license": "MIT",
  "dependencies": {
    "cfonts": "^3.3.0",
    "discord.js": "^14.17.0",
    "dotenv": "^16.4.5"
  }
}
